{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dizihospital/api",
    "type": "project",
    "description": "DiziHospital hospital platform API \u2014 the cloud tier the edge nodes drain into (P0-301)",
    "keywords": [
        "hospital",
        "api",
        "laravel"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fmt": "pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
