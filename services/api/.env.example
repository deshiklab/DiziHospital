# The API service's own environment. Nothing secret belongs in a committed file: this one names the variables and
# the shape of their values, and `services/api/README.md` says where each one comes from in a real deployment.

APP_NAME="DiziHospital API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

# One database, ten schemas, one per module: the seams are schemas rather than a naming convention, so a cross-module
# join is a missing grant rather than a code review comment.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dizihospital
DB_USERNAME=dizi
DB_PASSWORD=secret

# The rate limiter is the only thing here that caches, and this service ships no cache table: `array` means the limit
# is per worker, which is stated in the README rather than pretended away. A shared store is a deployment decision that
# arrives with the load balancer.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=database

# This node. DIZI_NODE_ID is the name the audit ledger and the number blocks are keyed by, and NODE_SECRET signs the
# leases on the blocks reserved to it — generate one per node and never share it between branches.
DIZI_NODE_ID=cloud-1
DIZI_BRANCH="Main Campus"
NODE_SECRET=

# Which driver verifies a bearer token, and there is no fallback between them: a verifier that falls back is one
# that can be made to fall back. `preview` exchanges a token this repository signs for itself (a checkout with no
# identity provider); `keycloak` verifies a real OIDC access token against the realm's published keys, which is what
# a deployment runs. The IAM secrets live in the deployment's secret store, never in a file like this one.
DIZI_AUTH_DRIVER=preview
AUTH_PREVIEW_SECRET=

# The realm a `keycloak` deployment trusts (`infra/keycloak/`). Only read when the driver is `keycloak`, and a
# service configured for it with no issuer refuses every request rather than guessing. OIDC_JWKS_URI overrides where
# the keys are fetched from, for a deployment that fronts Keycloak under another name.
OIDC_ISSUER=
OIDC_AUDIENCE=dizi-api
OIDC_JWKS_URI=
OIDC_JWKS_TTL_SECONDS=3600
OIDC_TIMEOUT_SECONDS=5

DIZI_BLOCK_SIZE=500
DIZI_BLOCK_LEASE_HOURS=72

# Where the one contract lives, relative to this service in a checkout and to the image root in a deployment.
DIZI_CONTRACT_PATH=../../packages/contracts/openapi.json
