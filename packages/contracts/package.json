{
  "name": "@dizi/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DiziHospital platform API contract — OpenAPI 3.1 with the offline, authority, idempotency and conflict metadata the client is driven from (P0-207)",
  "files": [
    "openapi.json",
    "dist",
    "README.md"
  ],
  "exports": {
    "./client": "./dist/client.ts",
    "./capabilities.json": "./dist/capabilities.json",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node check.mjs && node build.mjs --check",
    "self-test": "node check.mjs --self-test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
