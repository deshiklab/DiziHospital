node_modules/
.DS_Store

# Build output — never committed, except the token package, whose generated files are committed on purpose so
# the drift gate in CI has something to compare against (packages/tokens/dist).
.next/
.turbo/
coverage/
*.tsbuildinfo
apps/*/dist/
services/*/dist/
.env
.env.local
# production build output when built beside a running dev server
.next-build/

# The documentation site GitHub Pages publishes. It is ~50 MB of rendered pages and mirrored
# images, uploaded as a workflow artifact — `build-pdf.yml` runs `git add -A docs`, so without
# this line a local build would be committed by the next docs job.
docs/build/site/
