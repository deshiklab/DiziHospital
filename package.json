{
  "name": "dizihospital",
  "private": true,
  "version": "0.1.0",
  "description": "DiziHospital \u2014 modern hospital management platform (monorepo root)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens:build": "npm run build --workspace @dizi/tokens",
    "tokens:check": "npm run check --workspace @dizi/tokens",
    "clean-room": "node tools/ci/clean-room.mjs",
    "check:classes": "node tools/ci/display-order.mjs",
    "verify": "npm run clean-room && npm run tokens:check && npm run check:classes",
    "test:shell": "node tools/test/shell-nav.mjs",
    "test:runtime": "node tools/test/runtime.mjs"
  }
}
